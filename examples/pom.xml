<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Standalone project — deliberately NOT a <module> of the root pom.xml, and not part of the
      published library JAR. Its only purpose is runnable, copy-pasteable usage examples against
      a real GeoServer instance. See examples/README.md to run these.
    -->
    <groupId>io.github.kimbongjune</groupId>
    <artifactId>geoserver-client-examples</artifactId>
    <version>1.0.1</version>
    <packaging>jar</packaging>

    <name>GeoServer Client Examples</name>
    <description>Runnable usage examples for the geoserver-client library</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.kimbongjune</groupId>
            <artifactId>geoserver-client</artifactId>
            <version>1.0.1</version>
        </dependency>
        <!-- geoserver-client declares slf4j-api only; examples need a concrete binding to see logs -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.7</version>
        </dependency>
        <!-- Used only by Ex02 to create a real table via JDBC against the docker-compose PostGIS,
             so the PostGIS datastore example connects to genuinely live data, not just config. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>8</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
            </plugin>
        </plugins>
    </build>
</project>
